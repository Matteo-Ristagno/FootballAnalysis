				"source": [
					"# Libraries"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"from statsbombpy import sb\n",
					"import pandas as pd"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"linked_service_name = 'synw-football-WorkspaceDefaultStorage'\n",
					"adls_container_name = 'synapse'\n",
					"\n",
					"adls_sas_token = mssparkutils.credentials.getFullConnectionString(linked_service_name)\n",
					"adls_account_name = adls_sas_token.split('url=https://')[1].split(';token')[0]\n",
					"print(adls_account_name)"
				]
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"# Competitions"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"adls_relative_path = 'bronze/competitions'\n",
					"\n",
					"rootPath = f\"abfss://{adls_container_name}@{adls_account_name}/{adls_relative_path}\""
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"competitions = sb.competitions()\n",
					"\n",
					"df_competition = spark.createDataFrame(competitions)"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"df_competition.write.mode(\"overwrite\").parquet(\n",
					"    rootPath\n",
					")"
				]
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"# Matches"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"adls_relative_path = 'bronze/matches'\n",
					"\n",
					"rootPath = f\"abfss://{adls_container_name}@{adls_account_name}/{adls_relative_path}\""
				]
			},
			{
				"cell_type": "code",
				"source": [
					"all_matches = []\n",
					"\n",
					"competitions = sb.competitions()\n",
					"\n",
					"for _, c in competitions.iterrows():\n",
					"    matches = sb.matches(c[\"competition_id\"], c[\"season_id\"])\n",
					"    all_matches.append(matches)\n",
					"\n",
					"df_matches = spark.createDataFrame(pd.concat(all_matches, ignore_index=True))"
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"df_matches.write.mode(\"overwrite\").parquet(\n",
					"    rootPath\n",
					")"
				]
			}
		]
	}
